# Copy this file to .env and replace every placeholder with local-only values.
APP_NAME=CodeFrog AI API
APP_ENV=development
LOG_LEVEL=INFO
# Host port 5434 maps to PostgreSQL's port 5432 inside the Docker container.
DATABASE_URL=postgresql+psycopg://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5434/YOUR_DATABASE_NAME
AUTH_SECRET_KEY=REPLACE_WITH_A_RANDOM_32_CHARACTER_MINIMUM_SECRET
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET
# Must match the GitHub OAuth App's "Authorization callback URL" exactly. Use the same hostname
# (localhost) for the frontend, the backend, and this callback: do not mix localhost and 127.0.0.1.
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
# Scopes requested from GitHub. read:user and user:email are always requested; repo lets CodeFrog list
# private repositories, clone, push, and open pull requests.
GITHUB_OAUTH_SCOPES=read:user user:email repo
# The web frontend's origin: where the OAuth callback sends the browser, and the only allowed CORS origin.
FRONTEND_URL=http://localhost:3000
# Fernet key for stored GitHub tokens. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_GENERATED_FERNET_KEY
# Embedding provider for semantic search (OpenAI-compatible). The vector column is 1536-dimensional.
EMBEDDING_API_KEY=YOUR_EMBEDDING_PROVIDER_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
# LLM for the repository agent (OpenAI-compatible chat completions). Leave the key unset to disable it.
LLM_API_KEY=YOUR_LLM_PROVIDER_API_KEY
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# Maximum model calls per agent request (2-15); the last call must answer without tools.
AGENT_MAX_ITERATIONS=6
# Where persistent repository checkouts (Git working trees) live: WORKSPACE_ROOT/repositories/<repository-id>/.
# Default: a git-ignored .codefrog-workspaces folder in the project directory. Keep it outside cloud-synced folders.
# WORKSPACE_ROOT=

# Frontend (Next.js) setting: put it in frontend/.env.local, not here. The backend's address:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Used only by docker compose to create the local PostgreSQL database.
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=YOUR_DATABASE_NAME
