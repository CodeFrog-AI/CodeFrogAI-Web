# Copy this file to .env and replace every placeholder with local-only values.
APP_NAME=CodeFrog AI API
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/YOUR_DATABASE_NAME
AUTH_SECRET_KEY=REPLACE_WITH_A_RANDOM_32_CHARACTER_MINIMUM_SECRET
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Used only by docker compose to create the local PostgreSQL database.
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=YOUR_DATABASE_NAME
