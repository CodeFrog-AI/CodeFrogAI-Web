# Copy this file to .env and replace every placeholder with local-only values.
APP_NAME=CodeFrog AI API
APP_ENV=development
LOG_LEVEL=INFO
# Host port 5434 maps to PostgreSQL's port 5432 inside the Docker container.
DATABASE_URL=postgresql+psycopg://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5434/YOUR_DATABASE_NAME
AUTH_SECRET_KEY=REPLACE_WITH_A_RANDOM_32_CHARACTER_MINIMUM_SECRET
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
# Fernet key for stored GitHub tokens. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_GENERATED_FERNET_KEY
# Embedding provider for semantic search (OpenAI-compatible). The vector column is 1536-dimensional.
EMBEDDING_API_KEY=YOUR_EMBEDDING_PROVIDER_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
# LLM for the repository agent (OpenAI-compatible chat completions). Leave the key unset to disable it.
LLM_API_KEY=YOUR_LLM_PROVIDER_API_KEY
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# Maximum model calls per agent request (2-15); the last call must answer without tools.
AGENT_MAX_ITERATIONS=6

# Used only by docker compose to create the local PostgreSQL database.
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=YOUR_DATABASE_NAME
